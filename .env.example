# =========================================================
# GraphRAG Research Notebook - Environment Configuration
# All services listed below utilize Free-Tier / Open-Source resources.
# =========================================================

# 1. Google Gemini API Key (Free Tier via Google AI Studio)
# Obtain at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Neo4j AuraDB Free Tier Credentials
# Obtain at: https://neo4j.com/cloud/platform/aura-graph-database/
NEO4J_URI=neo4j+s://your-db-id.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_aura_password_here

# 3. Local Storage Configuration
CHROMADB_DIR=./data/chroma_db
SAMPLE_DATA_PATH=./data/sample_hotpotqa.json
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
